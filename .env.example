# Copy this file to .env and fill in the values you need.

# Spotify app client ID (https://developer.spotify.com/dashboard).
# You can also paste it into the setup screen in the browser instead.
SPOTIFY_CLIENT_ID=

# Port the local server listens on.
PORT=8888
HOST=127.0.0.1

# Public base URL. Used to build the OAuth redirect URI.
# Defaults to http://127.0.0.1:$PORT
# PUBLIC_URL=http://127.0.0.1:8888

# Exact redirect URI registered in the Spotify dashboard.
# Defaults to $PUBLIC_URL/auth/callback
# REDIRECT_URI=http://127.0.0.1:8888/auth/callback
